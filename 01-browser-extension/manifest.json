{
  "manifest_version": 3,
  "name": "Markdrop Clipper",
  "version": "0.1.0",
  "description": "Convert web pages, selections, images and YouTube videos to Markdown. From Dhiva Labs.",
  "homepage_url": "https://github.com/Dhiva-Labs/Markdrop",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Markdrop Clipper",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options/options.html",
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "downloads",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*"
  ],
  "commands": {
    "convert-article": {
      "suggested_key": { "default": "Alt+Shift+M" },
      "description": "Convert current page (article mode) to Markdown"
    }
  }
}
